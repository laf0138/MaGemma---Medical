#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║  specter-ask — SPECTER Offline AI Library CLI Query Tool ║
# ║                                                          ║
# ║  Usage:                                                  ║
# ║    specter-ask "How do I treat a tension pneumothorax?"  ║
# ║    specter-ask "What is the fallout shelter distance?"   ║
# ║    specter-ask --search "nuclear survival"               ║
# ║    specter-ask --status                                  ║
# ╚══════════════════════════════════════════════════════════╝

API="http://192.168.1.5:5001"
BOLD="\033[1m"
CYAN="\033[0;36m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
NC="\033[0m"

usage() {
  echo "Usage: specter-ask [OPTIONS] \"your query\""
  echo ""
  echo "Options:"
  echo "  --status           Show library service status"
  echo "  --search \"query\"   Keyword search only (no AI)"
  echo "  --categories       List available library categories"
  echo "  --help             Show this help"
  echo ""
  echo "Examples:"
  echo "  specter-ask \"How do I treat a sucking chest wound?\""
  echo "  specter-ask \"Nuclear fallout shelter construction techniques\""
  echo "  specter-ask \"LDS food storage guidelines\""
  echo "  specter-ask --search \"radiation dosimeter\""
}

if [[ $# -eq 0 ]]; then
  usage; exit 1
fi

case "$1" in
  --status)
    echo -e "${CYAN}SPECTER Library Status${NC}"
    curl -sf "$API/status" | python3 -m json.tool 2>/dev/null || \
      echo -e "${RED}Library API not reachable at $API${NC}"
    ;;

  --categories)
    echo -e "${CYAN}SPECTER Library Categories${NC}"
    curl -sf "$API/categories" | python3 -m json.tool 2>/dev/null || \
      echo -e "${RED}Library API not reachable at $API${NC}"
    ;;

  --search)
    shift
    QUERY="$*"
    if [[ -z "$QUERY" ]]; then echo "Query required"; exit 1; fi
    echo -e "${CYAN}Searching: ${BOLD}$QUERY${NC}"
    ENCODED=$(python3 -c "import urllib.parse; print(urllib.parse.quote('$QUERY'))")
    curl -sf "$API/search?q=$ENCODED&limit=5" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print(f\"\\nKiwix results: {len(data.get('kiwix_results',[]))}\")
for r in data.get('kiwix_results', []):
    print(f\"  • {r['title']}\")
    if r.get('snippet'):
        print(f\"    {r['snippet'][:120]}...\")
print(f\"\\nPDF results: {len(data.get('pdf_results',[]))}\")
for r in data.get('pdf_results', []):
    import os
    print(f\"  • {os.path.basename(r['source'])} (score: {r['score']:.2f})\")
    print(f\"    {r['content'][:120]}...\")
" 2>/dev/null || echo -e "${RED}Search failed${NC}"
    ;;

  --help|-h)
    usage
    ;;

  *)
    QUERY="$*"
    echo -e "${CYAN}◈ SPECTER AI LIBRARY${NC}"
    echo -e "${YELLOW}Query: ${BOLD}$QUERY${NC}"
    echo -e "${YELLOW}Searching library and generating answer...${NC}\n"

    PAYLOAD=$(python3 -c "import json; print(json.dumps({'query': '$QUERY'}))" 2>/dev/null)
    if [[ -z "$PAYLOAD" ]]; then
      # fallback for queries with special chars
      PAYLOAD="{\"query\": \"$QUERY\"}"
    fi

    RESPONSE=$(curl -sf -X POST "$API/ask" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD" 2>/dev/null)

    if [[ -z "$RESPONSE" ]]; then
      echo -e "${RED}Library API not reachable at $API${NC}"
      echo "Check: systemctl status specter-library-api.service"
      exit 1
    fi

    python3 -c "
import json, sys

data = json.loads('''$RESPONSE''')

print('\033[1m── ANSWER ───────────────────────────────────────────────────\033[0m')
print(data.get('answer', '[No answer returned]'))

sources = data.get('sources', [])
if sources:
    print('\n\033[0;36m── SOURCES ──────────────────────────────────────────────────\033[0m')
    for s in sources:
        if s['type'] == 'pdf':
            print(f\"  [{s['type'].upper()}] {s['file']}  ({s['category']})  score={s['score']:.2f}\")
        else:
            print(f\"  [{s['type'].upper()}] {s.get('title','')}\")

elapsed = data.get('elapsed_sec', 0)
model   = data.get('model', '')
print(f'\n\033[0;32m[{elapsed}s · {model}]\033[0m')
" 2>/dev/null || echo "$RESPONSE" | python3 -m json.tool
    ;;
esac
